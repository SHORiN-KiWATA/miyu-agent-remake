{
  "id": "todo",
  "version": "0.1.0",
  "name": {
    "zh": "待办",
    "ja": "ToDo"
  },
  "summary": {
    "zh": "在输入框上方显示 AI 的待办",
    "ja": "入力欄の上に AI の ToDo を表示"
  },
  "kind": "optional",
  "description": {
    "zh": "输入框上面常驻一块待办（照 TUI 窄屏）；照核心推的清单（D-3），全做完了停一下再收掉。"
  },
  "inject": [
    "slots",
    "chat"
  ],
  "settings": {
    "rows": {
      "type": "number",
      "default": 5,
      "min": 1,
      "integer": true,
      "name": {
        "zh": "默认露几行"
      }
    },
    "marks": {
      "type": "map",
      "of": "text",
      "default": {
        "pending": "☐",
        "active": "■",
        "done": "☑"
      },
      "name": {
        "zh": "没做、在做、做完的记号"
      }
    },
    "hold_ms": {
      "type": "duration",
      "default": 1500,
      "name": {
        "zh": "全做完了停多久再收掉"
      }
    }
  },
  "styles": [
    "style.css"
  ],
  "text": {
    "zh": {
      "title": "待办 {done}/{total}",
      "folded": "已完成 {count} 项",
      "more": "… 还有 {count} 项",
      "toggle": "点击展开或收起"
    },
    "ja": {
      "title": "ToDo {done}/{total}",
      "folded": "{count} 件完了",
      "more": "… 他 {count} 件",
      "toggle": "クリックで展開・折りたたみ"
    }
  }
}
