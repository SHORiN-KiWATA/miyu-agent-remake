{
  "id": "todo",
  "version": "0.1.0",
  "name": {
    "zh": "待办",
    "ja": "ToDo"
  },
  "summary": {
    "zh": "输入框上面列着她的待办",
    "ja": "入力欄の上に彼女の ToDo を表示"
  },
  "kind": "optional",
  "description": {
    "zh": "输入框上面常驻一块待办（照 TUI 窄屏）；核心还没有待办，/demo-todo 推一份演示的。"
  },
  "inject": [
    "slots",
    "commands",
    "chat"
  ],
  "settings": {
    "rows": {
      "type": "number",
      "default": 5,
      "min": 1,
      "integer": true,
      "name": {
        "zh": "默认露几行"
      }
    },
    "marks": {
      "type": "map",
      "of": "text",
      "default": {
        "pending": "☐",
        "active": "■",
        "done": "☑"
      },
      "name": {
        "zh": "没做、在做、做完的记号"
      }
    },
    "hold_ms": {
      "type": "duration",
      "default": 1500,
      "name": {
        "zh": "全做完了停多久再收掉"
      }
    },
    "demo_items": {
      "type": "list",
      "of": "text",
      "default": [
        "读蓝图里时间线的规则",
        "先写会报红的测试",
        "改时间线的连接线：出错的那一步从预览的竖线一路红到下一步的标题行，别的步照旧暗色",
        "跑测试和 clippy",
        "真机走查：宽屏、窄屏、首页各看一遍",
        "把走查的截图贴进蓝图",
        "更新 next-release-note",
        "等项目主人验收",
        "提交"
      ],
      "name": {
        "zh": "演示的待办"
      }
    },
    "every_ms": {
      "type": "duration",
      "default": 3000,
      "name": {
        "zh": "演示几毫秒推进一项"
      }
    }
  },
  "styles": [
    "style.css"
  ],
  "text": {
    "zh": {
      "title": "待办 {done}/{total}",
      "folded": "做完 {count} 项",
      "more": "… 还有 {count} 项",
      "toggle": "点一下展开、收起",
      "command": "演示：推一份假的待办"
    },
    "ja": {
      "title": "ToDo {done}/{total}",
      "folded": "{count} 件完了",
      "more": "… 他 {count} 件",
      "toggle": "クリックで展開・折りたたみ",
      "command": "デモ：仮の ToDo を表示する"
    }
  }
}
