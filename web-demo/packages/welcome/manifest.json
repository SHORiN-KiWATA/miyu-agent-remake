{
  "id": "welcome",
  "version": "0.1.0",
  "name": {
    "zh": "第一次引导",
    "en": "First-run setup",
    "ja": "初回セットアップ"
  },
  "summary": {
    "zh": "第一次打开时配置语言、模型、人格和预设",
    "en": "Set up language, model, persona and preset on first launch",
    "ja": "初回起動時に言語・モデル・人格・プリセットを設定"
  },
  "kind": "optional",
  "description": {
    "zh": "核心的 ui.welcomed 是 false 时整页盖上引导：欢迎 → 界面语言 → 模型 → 人格 → 预设 → 完成，走完写 true（蓝图 web.md「第一次引导」）。排在对话页之前、别的服务都是用到时现找：没走过引导的这台设备一打开先盖一层底色，不露出空会话。供应商那一段、控件经 settings 包的服务 settings，人格、预设经 setup 包的服务 personas，吉祥物经 mascot 包的服务 mascot。"
  },
  "inject": [
    "core",
    "language",
    "storage",
    "chat~",
    "composer~",
    "settings~",
    "personas~",
    "mascot~"
  ],
  "settings": {
    "stars": {
      "type": "number",
      "default": 16,
      "min": 0,
      "max": 60,
      "integer": true,
      "name": {
        "zh": "欢迎页的星点有几个"
      }
    },
    "mascot_scale": {
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 6,
      "integer": true,
      "name": {
        "zh": "欢迎页的吉祥物放大几倍"
      }
    }
  },
  "styles": [
    "style.css"
  ],
  "text": {
    "zh": {
      "brand": "Miyu",
      "steps": {
        "language": "语言",
        "model": "模型",
        "persona": "人格",
        "preset": "预设"
      },
      "hello": {
        "title": "欢迎使用 Miyu",
        "sub": "配置模型、人格和预设",
        "start": "开始",
        "hint": "按 Enter 开始"
      },
      "language": {
        "title": "界面语言",
        "sub": "可在设置中修改",
        "system": "跟随系统"
      },
      "back": "上一步",
      "next": "下一步",
      "done": {
        "title": "设置完成",
        "model": "模型 {name}",
        "persona": "人格 {name}",
        "preset": "预设 {name}",
        "start": "开始聊天"
      },
      "failed": "保存失败：{reason}"
    },
    "en": {
      "brand": "Miyu",
      "steps": {
        "language": "Language",
        "model": "Model",
        "persona": "Persona",
        "preset": "Preset"
      },
      "hello": {
        "title": "Welcome to Miyu",
        "sub": "Set up a model, persona and preset",
        "start": "Start",
        "hint": "Press Enter to start"
      },
      "language": {
        "title": "Interface language",
        "sub": "Can be changed in Settings",
        "system": "Follow system"
      },
      "back": "Back",
      "next": "Next",
      "done": {
        "title": "Setup complete",
        "model": "Model {name}",
        "persona": "Persona {name}",
        "preset": "Preset {name}",
        "start": "Start chatting"
      },
      "failed": "Save failed: {reason}"
    },
    "ja": {
      "brand": "Miyu",
      "steps": {
        "language": "言語",
        "model": "モデル",
        "persona": "人格",
        "preset": "プリセット"
      },
      "hello": {
        "title": "Miyu へようこそ",
        "sub": "モデル・人格・プリセットを設定します",
        "start": "始める",
        "hint": "Enter で開始"
      },
      "language": {
        "title": "表示言語",
        "sub": "設定で変更できます",
        "system": "システムに合わせる"
      },
      "back": "戻る",
      "next": "次へ",
      "done": {
        "title": "設定完了",
        "model": "モデル {name}",
        "persona": "人格 {name}",
        "preset": "プリセット {name}",
        "start": "チャットを始める"
      },
      "failed": "保存に失敗しました：{reason}"
    }
  }
}
