{
  "id": "theme",
  "version": "0.1.0",
  "name": {
    "zh-CN": "主题"
  },
  "kind": "base",
  "description": {
    "zh-CN": "照选中的那一套颜色把页面的颜色变量写上；一套一套的颜色由主题包挂进 theme.palettes。没选的跟着系统：浅色用第一套浅的，深色用第一套深的。"
  },
  "inject": [
    "slots",
    "packages"
  ],
  "provides": {
    "services": [
      "theme"
    ]
  },
  "settings": {
    "palette": {
      "type": "text",
      "default": "",
      "name": {
        "zh-CN": "用哪一套（空着的跟着系统）"
      },
      "applies": "live"
    }
  }
}
