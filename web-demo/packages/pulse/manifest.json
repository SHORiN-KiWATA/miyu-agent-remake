{
  "id": "pulse",
  "version": "0.1.0",
  "name": {
    "zh": "运行状态行",
    "ja": "実行状態行"
  },
  "summary": {
    "zh": "回答时输入框上面那一行：在做什么、用了多久",
    "ja": "回答中に入力欄の上に出る行：何をしているか・経過時間"
  },
  "kind": "optional",
  "description": {
    "zh": "回答时输入框上面一行：流光的词、点、用时、重试，下面列着排着的话（照 TUI 的运行状态行）。停用了回答时那一行没有，排着的话照样发。"
  },
  "inject": [
    "slots"
  ],
  "settings": {
    "sweep_seconds": {
      "type": "number",
      "default": 3,
      "min": 0.2,
      "name": {
        "zh": "流光扫一趟几秒"
      }
    },
    "dim": {
      "type": "number",
      "default": 0.85,
      "min": 0,
      "max": 1,
      "name": {
        "zh": "没扫到的字压到多暗（强调色的几成）"
      }
    },
    "lift": {
      "type": "number",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "name": {
        "zh": "亮光往白里偏几成"
      }
    },
    "dot_mark": {
      "type": "text",
      "default": ".",
      "name": {
        "zh": "点的记号"
      }
    },
    "dot_count": {
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 6,
      "integer": true,
      "name": {
        "zh": "最多几个点"
      }
    },
    "tick_ms": {
      "type": "duration",
      "default": 100,
      "name": {
        "zh": "多久重画一次"
      }
    },
    "words": {
      "type": "json",
      "default": {
        "dwell_ms": [
          12000,
          20000
        ],
        "quiet_ms": 2000,
        "idle_ms": [
          30000,
          45000
        ],
        "tiers": [
          {
            "after": 0,
            "words": {
              "zh": [
                "深度求索",
                "思考中",
                "斟酌中",
                "琢磨中",
                "推敲中",
                "容我想想",
                "稍等片刻"
              ],
              "ja": [
                "深く探索中",
                "思考中",
                "思案中",
                "吟味中",
                "推敲中",
                "うーん、ちょっと待って",
                "少々お待ちを"
              ]
            }
          },
          {
            "after": 30,
            "words": {
              "zh": [
                "抽丝剥茧",
                "穿针引线",
                "仔细推敲",
                "细细琢磨"
              ],
              "ja": [
                "紐解き中",
                "つなぎ合わせ中",
                "じっくり検討中",
                "反芻中"
              ]
            }
          },
          {
            "after": 90,
            "words": {
              "zh": [
                "深思熟虑",
                "反复推敲",
                "还在琢磨"
              ],
              "ja": [
                "熟考中",
                "何度も見直し中",
                "まだ思案中"
              ]
            }
          }
        ]
      },
      "name": {
        "zh": "词库（分档、停多久、安静多久换；每一档每种语言各一组）"
      },
      "advanced": true
    }
  },
  "styles": [
    "style.css"
  ],
  "text": {
    "zh": {
      "retry": " · 重试 {attempt}/{limit}：{message}",
      "retry_wait": " · {wait} 后重试 {attempt}/{limit}：{message}",
      "retry_failover": " · 换端点重试 {attempt}/{limit}：{message}"
    },
    "ja": {
      "retry": " · 再試行 {attempt}/{limit}：{message}",
      "retry_wait": " · {wait}後に再試行 {attempt}/{limit}：{message}",
      "retry_failover": " · エンドポイントを替えて再試行 {attempt}/{limit}：{message}"
    }
  }
}
