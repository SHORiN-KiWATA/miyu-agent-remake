{
  "id": "jobs",
  "version": "0.1.0",
  "name": {
    "zh-CN": "后台任务"
  },
  "kind": "optional",
  "description": {
    "zh-CN": "框下面那一行中间写有几个后台任务在跑，点开列出这个会话的后台命令、子代理（子代理再派的挂在它下面），能停掉在跑的、停在半路的，后台命令点开看输出。"
  },
  "inject": [
    "slots",
    "core",
    "sessions",
    "chat",
    "composer"
  ],
  "settings": {
    "tick_ms": {
      "type": "duration",
      "default": 1000,
      "name": {
        "zh-CN": "浮层开着时用时多久走一次"
      }
    },
    "fold_ms": {
      "type": "duration",
      "default": 380,
      "name": {
        "zh-CN": "「已结束」、预览展开收起多久（和时间线点开一步一样）"
      }
    },
    "preview_lines": {
      "type": "number",
      "default": 200,
      "min": 1,
      "max": 2000,
      "integer": true,
      "name": {
        "zh-CN": "后台命令的预览读最后几行"
      }
    }
  },
  "styles": [
    "style.css"
  ],
  "text": {
    "zh-CN": {
      "pill": "{count} 个后台任务",
      "open": "看后台任务",
      "stop": "停掉",
      "states": {
        "running": "运行中 {elapsed}",
        "done": "完成 {elapsed}",
        "done_plain": "完成",
        "failed": "失败 · 退出码 {code}",
        "signal": "失败 · 信号 {signal}",
        "stopped": "已停止",
        "undone": "随撤销停止",
        "restarted": "因重启停止",
        "aborted": "中断：核心退出过",
        "paused": "等你说话"
      },
      "reasons": {
        "unknown_job": "这个任务已经结束了",
        "not_a_command": "这是子代理，点它进它的会话"
      },
      "enter": "进这个子代理的会话",
      "stop_all": "全部停掉",
      "title": "后台任务",
      "counts": {
        "running": "{count} 个在跑",
        "paused": "{count} 个等你说话",
        "done": "{count} 个已结束"
      },
      "sections": {
        "done": "已结束 {count} 个"
      },
      "spawned": "派了 {count} 个",
      "empty": "这个会话还没有后台任务",
      "preview": {
        "open": "看命令和输出",
        "command": "命令",
        "output": "输出",
        "loading": "读取中…",
        "empty": "（还没有输出）",
        "no_command": "（读不到命令）",
        "no_api": "这个核心太旧，读不了输出（施工 7-4 补以后的核心才有）",
        "tail": "共 {total} 行，这里是最后 {shown} 行"
      }
    }
  }
}
