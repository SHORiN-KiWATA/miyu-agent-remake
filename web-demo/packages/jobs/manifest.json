      "preview": {
        "open": "コマンドと出力を見る",
        "command": "コマンド",
        "output": "出力",
        "loading": "読み込み中…",
        "empty": "（まだ出力がありません）",
        "no_command": "（コマンドを読み取れません）",
        "no_api": "このコアは古いため出力を読めません（施工 7-4 補以降のコアが必要です）",
        "tail": "全 {total} 行のうち最後の {shown} 行"
      }
    }
  }
}
