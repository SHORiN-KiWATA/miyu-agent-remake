{
  "id": "jobs",
  "version": "0.1.0",
  "name": {
    "zh": "后台任务",
    "en": "Background tasks",
    "ja": "バックグラウンドタスク"
  },
  "summary": {
    "zh": "查看和停止后台命令、子代理",
    "en": "View and stop background commands and subagents",
    "ja": "バックグラウンドのコマンドとサブエージェントを確認・停止"
  },
  "kind": "optional",
  "description": {
    "zh": "框下面那一行中间写有几个后台任务在跑，点开列出这个会话的后台命令、子代理（子代理再派的挂在它下面），能停掉在跑的、停在半路的，后台命令点开看输出。"
  },
  "inject": [
    "slots",
    "core",
    "sessions",
    "chat",
    "composer"
  ],
  "settings": {
    "tick_ms": {
      "type": "duration",
      "default": 1000,
      "name": {
        "zh": "浮层开着时用时多久走一次"
      }
    },
    "fold_ms": {
      "type": "duration",
      "default": 380,
      "name": {
        "zh": "「已结束」、预览展开收起多久（和时间线点开一步一样）"
      }
    },
    "preview_lines": {
      "type": "number",
      "default": 200,
      "min": 1,
      "max": 2000,
      "integer": true,
      "name": {
        "zh": "后台命令的预览读最后几行"
      }
    }
  },
  "styles": [
    "style.css"
  ],
  "text": {
    "zh": {
      "pill": "{count} 个后台任务",
      "open": "查看后台任务",
      "stop": "停止",
      "states": {
        "running": "运行中 {elapsed}",
        "done": "完成 {elapsed}",
        "done_plain": "完成",
        "failed": "失败 · 退出码 {code}",
        "signal": "失败 · 信号 {signal}",
        "stopped": "已停止",
        "undone": "随撤销停止",
        "restarted": "因重启停止",
        "aborted": "中断：核心已退出",
        "paused": "等待输入",
        "running_plain": "运行中"
      },
      "reasons": {
        "unknown_job": "任务已结束",
        "not_a_command": "这是子代理，请进入其会话"
      },
      "enter": "进入子代理会话",
      "stop_all": "全部停止",
      "title": "后台任务",
      "counts": {
        "running": "{count} 个运行中",
        "paused": "{count} 个等待输入",
        "done": "{count} 个已结束"
      },
      "sections": {
        "done": "已结束 {count} 个"
      },
      "spawned": "已派出 {count} 个",
      "empty": "本会话没有后台任务",
      "preview": {
        "open": "查看命令和输出",
        "command": "命令",
        "output": "输出",
        "loading": "加载中…",
        "empty": "（暂无输出）",
        "no_command": "（无法读取命令）",
        "no_api": "核心版本过旧，不支持读取输出",
        "tail": "共 {total} 行，显示最后 {shown} 行"
      }
    },
    "en": {
      "pill": "Background tasks: {count}",
      "open": "View background tasks",
      "stop": "Stop",
      "states": {
        "running": "Running {elapsed}",
        "done": "Done {elapsed}",
        "done_plain": "Done",
        "failed": "Failed · exit code {code}",
        "signal": "Failed · signal {signal}",
        "stopped": "Stopped",
        "undone": "Stopped by undo",
        "restarted": "Stopped by restart",
        "aborted": "Aborted: core exited",
        "paused": "Waiting for input",
        "running_plain": "Running"
      },
      "reasons": {
        "unknown_job": "Task already ended",
        "not_a_command": "This is a subagent, open its session"
      },
      "enter": "Open subagent session",
      "stop_all": "Stop all",
      "title": "Background tasks",
      "counts": {
        "running": "{count} running",
        "paused": "{count} waiting for input",
        "done": "{count} finished"
      },
      "sections": {
        "done": "Finished: {count}"
      },
      "spawned": "{count} spawned",
      "empty": "No background tasks in this session",
      "preview": {
        "open": "View command and output",
