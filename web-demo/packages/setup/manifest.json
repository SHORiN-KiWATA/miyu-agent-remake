{
  "id": "setup",
  "version": "0.1.0",
  "name": {
    "zh": "人格、预设与工作区",
    "en": "Personas, presets and workspace",
    "ja": "人格・プリセット・ワークスペース"
  },
  "summary": {
    "zh": "为新会话选择人格、预设和工作区",
    "en": "Choose a persona, preset and workspace for a new session",
    "ja": "新しいセッションで人格・プリセット・ワークスペースを選ぶ。セッション左上に表示"
  },
  "kind": "optional",
  "description": {
    "zh": "空会话里输入框上面三个按钮「选择人格」「选择预设」「设置工作区」，没选的照默认；默认的预设、人格用不了时锁住输入框。开着的会话左上角写人格、预设、工作目录；/workspace 换工作区。设置页的「人格」「预设」两页。"
  },
  "provides": {
    "services": [
      "personas"
    ]
  },
  "inject": [
    "slots",
    "icons",
    "chat",
    "composer",
    "core",
    "commands",
    "storage",
    "host",
    "sessions",
    "settings~"
  ],
  "settings": {
    "avatar_side": {
      "type": "number",
      "default": 512,
      "min": 64,
      "max": 1024,
      "integer": true,
      "name": {
        "zh": "换头像时图的长边最多多少像素，大的先缩小（核心收 1024 以内）",
        "ja": "アバターを変えるとき画像の長辺の最大ピクセル（大きいものは縮小。コアの上限は 1024）"
      }
    },
    "avatar_chunk_bytes": {
      "type": "number",
      "default": 262144,
      "min": 1024,
      "max": 524288,
      "integer": true,
      "name": {
        "zh": "传头像时一块多少字节（核心收的上限 512 KiB）",
        "ja": "アバターを送るときの 1 ブロックのバイト数（コアの上限 512 KiB）"
      }
    },
    "avatar_tries": {
      "type": "number",
      "default": 3,
      "min": 1,
      "integer": true,
      "name": {
        "zh": "传头像接不上时，连着几次没往前走就算传不上",
        "ja": "アバターの送信が続かないとき、何回連続で進まなければ失敗とみなすか"
      }
    },
    "preset_icons": {
      "type": "list",
      "of": "text",
      "default": [
        "box",
        "boxes",
        "package",
        "layers",
        "wrench",
